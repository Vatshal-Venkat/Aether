{"nodes": [{"id": "docs_how_it_works", "label": "How Aether Works (plain-language guide)", "file_type": "document", "source_file": "docs/how-it-works.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_aether", "label": "Aether health-data chatbot", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_synthea", "label": "Synthea synthetic patient data", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real patient records are legally protected, so 111 fake patients (~180K rows, 18 tables) are used; digits in names prevent confusion with real people."}, {"id": "docs_how_it_works_clinical_db", "label": "clinical_db (PostgreSQL medical records)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_billing_db", "label": "billing_db (MySQL billing/insurers/doctors)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two separate database engines on purpose, mirroring a real hospital where records and billing live in different systems."}, {"id": "docs_how_it_works_drug_labels_chromadb", "label": "ChromaDB drug_labels collection", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_settings_env", "label": "Settings card and .env secrets", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L54", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Secrets live only in an uncommitted .env; code reads them only through settings, so no secret is hard-coded. Also holds safety limits (10s query timeout, 3 SQL retries)."}, {"id": "docs_how_it_works_date_vs_timestamp", "label": "Calendar dates vs UTC timestamps", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Birthdays stored as moments shifted by timezone (IST 5:30, or previous day behind UTC); calendar days now stored as plain dates and moments always read in UTC."}, {"id": "docs_how_it_works_setup_databases_script", "label": "setup_databases script (--reset / --rls-only)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_chatbot_ro", "label": "chatbot_ro read-only database account", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Even if the AI writes a harmful command, the database refuses it because the login can only read."}, {"id": "docs_how_it_works_row_level_security", "label": "PostgreSQL row-level security (patient privacy filter)", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L88", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Database itself enforces clinician-sees-all / patient-sees-own via a per-request session note; no note means no rows (safe default)."}, {"id": "docs_how_it_works_rls_signature", "label": "Signed who-is-asking note (SHA-256 RLS signature)", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L223", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defense in depth: a query that rewrote its own session note saw all 111 patients; a SHA-256 of secret+role+patient id, with the key in a table chatbot_ro cannot read, makes tampered notes match nothing (0 extra rows). Key derived from DB admin password."}, {"id": "docs_how_it_works_connections_health", "label": "DB connections with 10s timeout and /health endpoint", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L97", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_schema_catalog", "label": "Schema catalog (PII columns removed)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L104", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI sees only relevant tables plus glossary, never private columns or the whole database; short accurate context yields better SQL. Lists possible values of short category columns after the gender='female' vs 'F' bug."}, {"id": "docs_how_it_works_semantic_layer", "label": "Semantic layer / glossary", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L107", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared dictionary so terms like HbA1c, active medication, revenue, outstanding balance always mean the same thing; several data bugs were fixed in the glossary alone without code changes."}, {"id": "docs_how_it_works_safety_inspector", "label": "SQL safety inspector (parse-tree validation)", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parses each AI query rather than keyword-matching; rejects writes, multi-statements, SELECT INTO, dangerous functions, unknown tables, private columns (incl. whole-row packing), and adds a LIMIT."}, {"id": "docs_how_it_works_function_allowlist", "label": "SQL function allow-list", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L132", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "query_to_xml ran hidden SQL inside a string and bypassed the block-list; an allow-list also stops dangers nobody thought of."}, {"id": "docs_how_it_works_name_resolution_defense", "label": "CTE/alias name-resolution defense", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L141", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A CTE named 'patients' or an alias like FROM payers AS claims confused the inspector; names are now resolved step by step and aliases checked against every table they could mean."}, {"id": "docs_how_it_works_llm_gateway", "label": "LLM gateway (Groq default, Gemini/Ollama, JSON mode)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L147", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_groq_fallback_model", "label": "Groq fallback model (gpt-oss-20b, GROQ_FALLBACK_MODEL)", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L154", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Daily quota exhaustion is not fixed by retrying, so skip retries, use the smaller model until the main model's reset time, then Gemini; per-minute limits still get quick retries."}, {"id": "docs_how_it_works_langgraph_pipeline", "label": "LangGraph question pipeline", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L161", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_contextualize_step", "label": "Contextualize step (follow-up rewrite)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L314", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_router", "label": "Router step (scope, permission, database choice)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L459", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_cross_database_plan", "label": "Cross-database plan step", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L181", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two engines cannot be joined in one query; AI splits into two steps linked by an approved key list, and code (not AI) injects step-1 ids into step 2 so ids cannot be mistyped or injected."}, {"id": "docs_how_it_works_merge_step", "label": "Merge step (join results on shared id)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L193", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_sql_retry", "label": "SQL self-correction retry (max 3 per step)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L473", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_number_check", "label": "Number fact-check step", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L488", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every number in the answer must appear in result rows or label passages; else one rewrite, then a warning. Handles number words, ranks, negatives, look-alike hyphens."}, {"id": "docs_how_it_works_mysql_query_rewrite", "label": "MySQL patient query rewrite (derived-table filter)", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L198", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MySQL has no RLS, so code rewrites the parsed query swapping each patient table for a pre-filtered derived table (covers joins, subqueries, CTEs, UNIONs). Two techniques used on purpose to learn both."}, {"id": "docs_how_it_works_hidden_totals", "label": "Hidden company-wide totals in patient mode", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L218", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Insurer/hospital/doctor totals describe other patients, so they are removed from the catalog and blocked by the safety check in patient mode."}, {"id": "docs_how_it_works_web_api", "label": "Web API (/api/chat, /api/patients, /api/schema)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L165", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_build_drug_index", "label": "build_drug_index script", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L240", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_openfda", "label": "openFDA drug labels (DailyMed citations)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L235", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_embedding_semantic_search", "label": "Local embeddings and semantic search (all-MiniLM-L6-v2, 384-dim)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L250", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_rag", "label": "RAG answering from drug labels", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L255", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retrieve per-drug only so a neighbouring drug's facts cannot leak in; passages are fenced as reference text (prompt-injection defence); unknown drugs get 'no label' instead of a guess; named label sections are read exhaustively for checklist questions."}, {"id": "docs_how_it_works_hybrid_query", "label": "Hybrid records + labels questions", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L273", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_website", "label": "Aether website (black-and-white hairline UI)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L284", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Monochrome, 1px lines, no shadows so data stands out; switching Clinician/Patient wipes the conversation so answers never cross views."}, {"id": "docs_how_it_works_thinking_orbs", "label": "Thinking orbs (SVG goo animation)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L291", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_conversation_memory", "label": "Conversation memory (memory.sqlite)", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L326", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores question, rewrite, first 400 chars of answer, never result tables; keyed by conversation+role+patient so another identity finds nothing."}, {"id": "docs_how_it_works_clarifying_questions", "label": "Asking back with one-click options", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L319", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_service_layer", "label": "Service layer around the pipeline (service.py)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L334", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_answer_cache", "label": "Answer cache (10 min, first questions only)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L336", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_pagination", "label": "Paged results with per-user tickets", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L340", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_rate_limiting", "label": "Rate limiting (20/min) and AI concurrency cap (2)", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L343", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The free AI tier is the bottleneck."}, {"id": "docs_how_it_works_audit_log", "label": "Audit logbook (audit.sqlite, /api/audit)", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L346", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read API is off unless ENABLE_AUDIT_API=true because without login it would expose every patient's questions."}, {"id": "docs_how_it_works_prometheus_metrics", "label": "Prometheus /metrics live counters", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L350", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_reranker", "label": "Cross-encoder reranker (ms-marco-MiniLM-L-6-v2)", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L355", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Of 3 free rerankers it ranked the right passage first on all 4 test questions; bge-reranker-base was ~4x slower and no better. ~0.7s per drug question; falls back to search order; RAG_RERANK=false disables."}, {"id": "docs_how_it_works_auto_charts", "label": "Automatic charts (bar/line, no chart library)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L363", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_csv_export", "label": "CSV export with formula-injection defusing", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L368", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_query_suggestions", "label": "Answerable-question suggestions after failure", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L376", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_extremes_check", "label": "Peak/highest/lowest claim check", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L380", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI saw only the first 10 of 17 rows and called 382 the peak (real 502); the number check passed because 382 was real. Code now computes extremes over all rows and verifies superlative claims (CL13)."}, {"id": "docs_how_it_works_row_meaning", "label": "Rows-are-not-patients check", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L389", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "19 diagnosis rows for 8 patients were reported as 19 patients; SQL writer, answer writer and checker now distinguish rows from distinct patients (CV05)."}, {"id": "docs_how_it_works_saved_queries", "label": "Saved queries (deterministic SQL reuse)", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L400", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Temperature-0 SQL still varied across runs and models; reusing the first clean route/plan/SQL gives identical results. Saved SQL still passes validation and privacy filter, stored pre-patient-filter, retired when glossary/rules change, time-relative questions never saved."}, {"id": "docs_how_it_works_similar_question_matching", "label": "Reworded question matching (embedding score + word check)", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L423", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Similarity scores alone were unsafe ('do not have diabetes' 0.912 > true rewording 0.876); negations, opposites, numbers and time words force a fresh answer, uncertain matches ask the user."}, {"id": "docs_how_it_works_assumption_check", "label": "Assumption confirmation (ask instead of assume)", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L439", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decided 2026-11-20: router must list assumptions about meaning; code asks the user to confirm before running. Data definitions are not assumptions."}, {"id": "docs_how_it_works_tie_aware_limit", "label": "Tie-aware top-N (RANK re-run)", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L699", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LIMIT 5 silently dropped 4 of 7 patients tied at 42.28; when ORDER BY...LIMIT N returns exactly N rows, code re-runs with RANK() to keep ties."}, {"id": "docs_how_it_works_trigram_search", "label": "Trigram typo matching (patient picker, medicine names)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L705", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typos are never silently guessed: 'Did you mean metformin?' with Yes/No; plain Python ~0.5ms, no AI call."}, {"id": "docs_how_it_works_accuracy_eval", "label": "Accuracy exam (run_eval, questions.yaml, code-marked)", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L654", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers marked by code against trusted SQL run at exam time, not by another AI; rate-limited questions are 'not run' rather than wrong. Clean full run 19 Nov 2026: 47/48 (98%)."}, {"id": "docs_how_it_works_stale_synthea_totals", "label": "Stale Synthea precomputed totals (covered_encounters etc.)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L691", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "payers.covered_encounters, covered_medications, providers.encounters, organizations.utilization disagree with loaded records; glossary marks them 'do not use - count the real rows'."}, {"id": "docs_how_it_works_patient_name_guard", "label": "Code-level other-patient name guard", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L638", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A weaker model let a privacy question through; anything that must always hold is checked by code before the AI. Single surname words count only if no doctor shares them (fixed 63/111 false refusals)."}, {"id": "docs_how_it_works_cloud_ai_tradeoff", "label": "Cloud AI acceptable only with fake data (HIPAA)", "file_type": "rationale", "source_file": "docs/how-it-works.md", "source_location": "L739", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local models take 10-30s per question; Groq is fast and writes better SQL, but sends data to the provider, which HIPAA forbids for real data without a BAA."}, {"id": "docs_how_it_works_doctor_vs_patient_view", "label": "Clinician view vs patient view", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L724", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_how_it_works_pii_columns", "label": "Hidden PII columns (SSN, driver's licence, passport)", "file_type": "concept", "source_file": "docs/how-it-works.md", "source_location": "L736", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_how_it_works", "target": "docs_how_it_works_aether", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/how-it-works.md", "source_location": "L7", "weight": 1.0}, {"source": "docs_how_it_works_aether", "target": "docs_how_it_works_synthea", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/how-it-works.md", "source_location": "L27", "weight": 1.0}, {"source": "docs_how_it_works_synthea", "target": "docs_how_it_works_clinical_db", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/how-it-works.md", "source_location": "L65", "weight": 1.0}, {"source": "docs_how_it_works_synthea", "target": "docs_how_it_works_billing_db", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/how-it-works.md", "source_location": "L65", "weight": 1.0}, {"source": "docs_how_it_works_aether", "target": "docs_how_it_works_clinical_db", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/how-it-works.md", "source_location": "L44", "weight": 1.0}, {"source": "docs_how_it_works_aether", "target": "docs_how_it_works_billing_db", "relation": "refer