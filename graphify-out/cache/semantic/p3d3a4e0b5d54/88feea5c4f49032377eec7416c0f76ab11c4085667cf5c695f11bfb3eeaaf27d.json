{"nodes": [{"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design", "label": "Aether Healthcare Multi-DB Chatbot Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_aether", "label": "Aether chatbot", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Learning project: understand end-to-end how a chatbot routes questions, writes safe SQL, merges cross-DB results and does RAG, and measure it; free/open source, runs on owner's Windows laptop, not deployed."}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_clinical_db", "label": "PostgreSQL clinical_db", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_billing_db", "label": "MySQL billing_db", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_chromadb_drug_labels", "label": "ChromaDB drug_labels store", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_synthea", "label": "Synthea synthetic patient data", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": "L85", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Synthetic data only, so sending it to free-tier cloud LLMs is acceptable; real patient data never could be (no HIPAA BAA)."}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_openfda_label_api", "label": "openFDA drug label API", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": "L103", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_clinician_patient_roles", "label": "Clinician / Patient roles (view as)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No authentication in this phase; role is a request field."}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_langgraph_pipeline", "label": "LangGraph pipeline of hand-written nodes (Approach B)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen by owner: framework handles retry loop, branching and memory; nodes stay small commented Python functions so the owner can follow them."}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_handwritten_pipeline", "label": "Hand-written plain Python pipeline (Approach A)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": "L75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most transparent but more plumbing; not chosen."}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_trino_federation", "label": "Trino federation engine (Approach C, deferred)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Heavy (Java, RAM next to LLM), fiddly on Windows without Docker, connects as one user so Postgres RLS can't see who's asking; deferred as optional comparison mode."}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_middleware_merge_federation", "label": "Federation with middleware merge", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Query each live DB in place and merge in Python, plus a lightweight semantic layer instead of a heavy virtualization tool."}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_semantic_glossary", "label": "Semantic glossary (glossary.yaml)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": "L81", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_cost_authority_rule", "label": "Authoritative cost source rule", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": "L110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cost appears in both DBs; glossary defines which source answers which money question so answers are consistent."}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_read_only_accounts", "label": "Read-only DB accounts (chatbot_ro)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": "L119", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_postgres_row_level_security", "label": "PostgreSQL native Row-Level Security", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": "L122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two row-filtering techniques chosen deliberately to teach both; chatbot_ro is not table owner so RLS applies."}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_mysql_row_filter_rewrite", "label": "MySQL sqlglot row-filter rewrite", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": "L125", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MySQL has no RLS, so patient-bearing tables are replaced with filtered derived tables in middleware."}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_audit_log", "label": "Audit log", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-17-healthcare-multidb-chatbot-design.md", "source_location": "L129", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_17_healthcare_multidb_chatbot_design_pii_exclusion", "label": "PII column exclusion (ssn, drivers, passport)", "file_type": "concept", "source_file": "docs/su