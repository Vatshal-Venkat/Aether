# Port of the Aether backend (python -m scripts.serve). The website reads this same line. Default 8000.
AETHER_API_PORT=8000

# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored: secrets never get committed.

# --- PostgreSQL (medical record: clinical_db) ---
PG_HOST=localhost
PG_PORT=5432
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=the-password-you-chose-when-installing-postgres

# Cloud Postgres (Neon): require encrypted connections. Leave empty locally.
PG_SSLMODE=

# --- MySQL (billing: billing_db) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=the-root-password-you-chose-when-installing-mysql
# Cloud MySQL only (leave empty / localhost on your computer):
#   MYSQL_SSL_CA  — certificate file that proves the server is genuine (Aiven: the project's ca.pem)
#   MYSQL_RO_HOST — where the read-only account may log in from: % (anywhere) for a cloud database
MYSQL_SSL_CA=
MYSQL_RO_HOST=localhost

# Password for the read-only "chatbot_ro" account. The setup script CREATES this
# account in both databases with this password — invent any strong password here.
RO_PASSWORD=invent-a-strong-password

# Optional: key that signs the "who is asking" note for PostgreSQL row-level security.
# Leave empty to derive it from PG_ADMIN_PASSWORD. If you change either, re-run:
#   python -m scripts.setup_databases --rls-only
RLS_SECRET=

# --- AI provider: groq (default) | gemini | ollama ---
LLM_PROVIDER=groq
GROQ_API_KEY=paste-your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b
# Used automatically when GROQ_MODEL's daily allowance runs out (separate allowance). Empty = off.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Optional extras (used as fallbacks if set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Show the audit logbook at /api/audit (no login: it reveals every patient's questions). Off by default.
ENABLE_AUDIT_API=false

# Websites allowed to call the API from a browser, comma-separated (deployed: your Vercel address).
# localhost is always allowed.
CORS_ORIGINS=
