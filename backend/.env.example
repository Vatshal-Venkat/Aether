# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored: secrets never get committed.

# --- PostgreSQL (medical record: clinical_db) ---
PG_HOST=localhost
PG_PORT=5432
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=the-password-you-chose-when-installing-postgres

# --- MySQL (billing: billing_db) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=the-root-password-you-chose-when-installing-mysql

# Password for the read-only "chatbot_ro" account. The setup script CREATES this
# account in both databases with this password — invent any strong password here.
RO_PASSWORD=invent-a-strong-password

# --- AI provider: groq (default) | gemini | ollama ---
LLM_PROVIDER=groq
GROQ_API_KEY=paste-your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b
# Optional extras (used as fallbacks if set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
